+bool XArmPlanner::setVelocityScalingFactor(double factor)
+{
+    if (!std::isfinite(factor) || factor <= 0.0 || factor > 1.0) {
+        RCLCPP_ERROR(node_->get_logger(),
+            "velocity scaling factor must be finite and in (0, 1], got %.3f", factor);
+        return false;
+    }
+    move_group_->setMaxVelocityScalingFactor(factor);
+    RCLCPP_INFO(node_->get_logger(), "MoveIt velocity scaling set to %.1f%%", factor * 100.0);
+    return true;
+}
