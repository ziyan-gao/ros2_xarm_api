+void XArmPlannerRunner::motion_speed_cb(const std_msgs::msg::Float64MultiArray::SharedPtr msg)
+{
+    if (msg->data.empty()) {
+        RCLCPP_WARN(node_->get_logger(), "ignoring empty motion speed configuration");
+        return;
+    }
+    const double velocity_scaling = msg->data[0];
+    if (!std::isfinite(velocity_scaling) || velocity_scaling <= 0.0 || velocity_scaling > 1.0) {
+        RCLCPP_WARN(node_->get_logger(), "ignoring invalid MoveIt velocity scaling %.3f", velocity_scaling);
+        return;
+    }
+    xarm_planner_->setVelocityScalingFactor(velocity_scaling);
+}
