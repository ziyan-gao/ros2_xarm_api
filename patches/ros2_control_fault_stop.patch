+TEST_F(ResourceManagerPreparePerformTest, faulted_interfaces_can_stop_but_cannot_restart)
+{
+  auto command = rm_->claim_command_interface("joint3/position");
+  ASSERT_TRUE(command.set_value(test_constants::WRITE_FAIL_VALUE));
+  rm_->write(node_.now(), rclcpp::Duration(0, 1000000));
+  ASSERT_TRUE(rm_->command_interface_exists("joint3/position"));
+  ASSERT_FALSE(rm_->command_interface_is_available("joint3/position"));
+  EXPECT_TRUE(rm_->prepare_command_mode_switch(empty_keys, legal_keys_actuator));
+  EXPECT_TRUE(rm_->perform_command_mode_switch(empty_keys, legal_keys_actuator));
+  EXPECT_FALSE(rm_->prepare_command_mode_switch(legal_keys_actuator, empty_keys));
+  EXPECT_FALSE(rm_->prepare_command_mode_switch(legal_keys_actuator, legal_keys_actuator));
+  EXPECT_FALSE(rm_->prepare_command_mode_switch(empty_keys, non_existing_keys));
+  EXPECT_FALSE(rm_->command_interface_is_available("joint3/position"));
+}
