+    bool XArmDriver::copy_report_joint_states(
+        std::vector<double>& positions,
+        std::vector<double>& velocities,
+        double& age_seconds)
+    {
+        std::lock_guard<std::mutex> lock(report_joint_state_mutex_);
+        if (!report_joint_state_ready_ ||
+            positions.size() < static_cast<size_t>(dof_) ||
+            velocities.size() < static_cast<size_t>(dof_)) {
+            return false;
+        }
+        for (int i = 0; i < dof_; ++i) {
+            positions[i] = report_joint_positions_[i];
+            velocities[i] = report_joint_velocities_[i];
+        }
+        age_seconds = std::chrono::duration<double>(
+            std::chrono::steady_clock::now() - report_joint_state_time_).count();
+        return true;
+    }
