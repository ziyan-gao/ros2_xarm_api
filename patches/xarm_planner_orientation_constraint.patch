+bool XArmPlanner::planPoseTargetOrientationConstrained(
+    const geometry_msgs::msg::Pose& pose_target)
+{
+    moveit_msgs::msg::OrientationConstraint orientation_constraint;
+    orientation_constraint.header.frame_id = move_group_->getPlanningFrame();
+    orientation_constraint.link_name = move_group_->getEndEffectorLink();
+    orientation_constraint.orientation = pose_target.orientation;
+    // Keep the tool tilt within three degrees while allowing arbitrary yaw
+    // about its own Z axis. Rotation-vector parameterization avoids the Euler
+    // singularity at the commanded downward (roll=pi) tool orientation.
+    constexpr double tilt_tolerance = 0.05235987755982989;
+    orientation_constraint.absolute_x_axis_tolerance = tilt_tolerance;
+    orientation_constraint.absolute_y_axis_tolerance = tilt_tolerance;
+    orientation_constraint.absolute_z_axis_tolerance = 3.141592653589793;
+    orientation_constraint.weight = 1.0;
+    orientation_constraint.parameterization =
+        moveit_msgs::msg::OrientationConstraint::ROTATION_VECTOR;
+
+    moveit_msgs::msg::Constraints path_constraints;
+    path_constraints.name = "keep_tcp_roll_pitch";
+    path_constraints.orientation_constraints.push_back(orientation_constraint);
+    move_group_->setPathConstraints(path_constraints);
+
+    bool success = move_group_->setPoseTarget(pose_target);
+    if (!success) {
+        RCLCPP_WARN(node_->get_logger(),
+            "setPoseTarget orientation-constrained: out of bounds");
+        move_group_->clearPathConstraints();
+        return false;
+    }
+    success = (move_group_->plan(xarm_plan_) ==
+        moveit::core::MoveItErrorCode::SUCCESS);
+    move_group_->clearPathConstraints();
+    if (!success)
+        RCLCPP_ERROR(node_->get_logger(),
+            "planPoseTarget orientation-constrained: plan failed");
+    else
+        publishPlan();
+    is_trajectory_ = false;
+    return success;
+}
