+  const long long send_started = get_us();
+  if (send_started >= deadline) return finish(UXBUS_STATE::ERR_TOUT, "before_send");
+  const int transaction = _send_modbus_request(UXBUS_RG::MOVE_SERVOJ, data, 40);
+  send_us = get_us() - send_started;
+  if (transaction == -1) return finish(UXBUS_STATE::ERR_NOTTCP, "send");
+  const long long reply_started = get_us();
