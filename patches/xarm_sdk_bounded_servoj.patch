+  std::unique_lock<std::mutex> locker(mutex_, std::defer_lock);
+  auto finish = [&](int code, const char *phase) {
+    const long long total_us = get_us() - started;
+    if (total_us >= 50000 && (code == 0 || code == UXBUS_STATE::WAR_CODE))
+      code = UXBUS_STATE::ERR_TOUT;
+    const bool failed = code != 0 && code != UXBUS_STATE::WAR_CODE;
+    if (failed) servo_write_fault_latched_.store(true);
+    if (locker.owns_lock()) locker.unlock();
+    if (failed || total_us > 30000) {
+      XARM_LOG_ERROR("Servo-J bounded write: phase=%s ret=%d lock_us=%lld send_us=%lld reply_us=%lld total_us=%lld budget_us=50000 latched=%d\n",
+                     phase, code, lock_us, send_us, reply_us, total_us, failed);
+    }
+    return code;
+  };
+  while (!locker.try_lock()) {
+    lock_us = get_us() - started;
+    if (lock_us >= 5000) return finish(UXBUS_STATE::ERR_TOUT, "lock");
+    sleep_us(100);
+  }
+  lock_us = get_us() - started;
