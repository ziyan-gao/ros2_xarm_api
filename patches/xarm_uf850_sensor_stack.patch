diff --git a/xarm_description/urdf/other/uf850_sensor_stack.urdf.xacro b/xarm_description/urdf/other/uf850_sensor_stack.urdf.xacro
new file mode 100644
index 0000000..f850001
--- /dev/null
+++ b/xarm_description/urdf/other/uf850_sensor_stack.urdf.xacro
@@ -0,0 +1,40 @@
+<?xml version="1.0"?>
+<robot xmlns:xacro="http://ros.org/wiki/xacro" name="uf850_sensor_stack">
+  <!-- Physical stack between the UF850 flange and the official vacuum tool. -->
+  <xacro:macro name="uf850_sensor_stack" params="prefix:='' attach_to:=''">
+    <joint name="${prefix}ft_sensor_mount" type="fixed">
+      <parent link="${attach_to}"/>
+      <child link="${prefix}ft_sensor_link"/>
+      <origin xyz="0 0 0" rpy="0 0 0"/>
+    </joint>
+    <link name="${prefix}ft_sensor_link">
+      <visual>
+        <origin xyz="0 0 0.0325" rpy="0 0 0"/>
+        <geometry><cylinder radius="0.045" length="0.065"/></geometry>
+        <material name="${prefix}ft_sensor_gray"><color rgba="0.28 0.30 0.33 1"/></material>
+      </visual>
+      <collision>
+        <!-- Leave a 1 mm collision-only gap at the fixed-link boundary. -->
+        <origin xyz="0 0 0.032" rpy="0 0 0"/>
+        <geometry><cylinder radius="0.045" length="0.064"/></geometry>
+      </collision>
+    </link>
+
+    <joint name="${prefix}camera_stand_mount" type="fixed">
+      <parent link="${prefix}ft_sensor_link"/>
+      <child link="${prefix}camera_stand_link"/>
+      <origin xyz="0 0 0.065" rpy="0 0 0"/>
+    </joint>
+    <link name="${prefix}camera_stand_link">
+      <visual>
+        <origin xyz="0 0 0.0015" rpy="0 0 0"/>
+        <geometry><cylinder radius="0.045" length="0.003"/></geometry>
+        <material name="${prefix}camera_stand_blue"><color rgba="0.12 0.32 0.62 1"/></material>
+      </visual>
+      <collision>
+        <origin xyz="0 0 0.0015" rpy="0 0 0"/>
+        <geometry><cylinder radius="0.045" length="0.003"/></geometry>
+      </collision>
+    </link>
+  </xacro:macro>
+</robot>
diff --git a/xarm_description/urdf/xarm_device_macro.xacro b/xarm_description/urdf/xarm_device_macro.xacro
