@@ -277,7 +277,15 @@
       </xacro:if>
       <xacro:unless value="${robot_type == 'lite'}">
         <!-- Load XArm Vacuum Gripper Model URDF -->
         <xacro:include filename="$(find xarm_description)/urdf/vacuum_gripper/xarm_vacuum_gripper.urdf.xacro" />
-        <xacro:xarm_vacuum_gripper_urdf prefix="${prefix}" attach_to="${prefix}link_eef" />
+        <xacro:if value="${robot_type == 'uf850'}">
+          <!-- UF850 stack: 65 mm FT sensor + 3 mm camera stand + vacuum tool. -->
+          <xacro:include filename="$(find xarm_description)/urdf/other/uf850_sensor_stack.urdf.xacro" />
+          <xacro:uf850_sensor_stack prefix="${prefix}" attach_to="${prefix}link_eef" />
+          <xacro:xarm_vacuum_gripper_urdf prefix="${prefix}" attach_to="${prefix}camera_stand_link" attach_xyz="0 0 0.003" tcp_xyz="0 0 0.104" />
+        </xacro:if>
+        <xacro:unless value="${robot_type == 'uf850'}">
+          <xacro:xarm_vacuum_gripper_urdf prefix="${prefix}" attach_to="${prefix}link_eef" />
+        </xacro:unless>
       </xacro:unless>
     </xacro:if>
diff --git a/xarm_moveit_config/srdf/_uf850_macro.srdf.xacro b/xarm_moveit_config/srdf/_uf850_macro.srdf.xacro
index 35f283c..b58a850 100644
--- a/xarm_moveit_config/srdf/_uf850_macro.srdf.xacro
+++ b/xarm_moveit_config/srdf/_uf850_macro.srdf.xacro
@@ -211,4 +211,15 @@
     <disable_collisions link1="${prefix}link5" link2="${prefix}link6" reason="Adjacent" />
     <disable_collisions link1="${prefix}link6" link2="${prefix}link_eef" reason="Adjacent" />
+
+    <!-- The UF850 sensor/camera/vacuum assembly is one rigid body.  Ignore
+         proximity only among its fixed components so Servo does not scale a
+         valid command to zero; collisions with the arm and scene stay active. -->
+    <disable_collisions link1="${prefix}link_eef" link2="${prefix}ft_sensor_link" reason="Adjacent" />
+    <disable_collisions link1="${prefix}link_eef" link2="${prefix}camera_stand_link" reason="RigidToolStack" />
+    <disable_collisions link1="${prefix}ft_sensor_link" link2="${prefix}camera_stand_link" reason="Adjacent" />
+    <disable_collisions link1="${prefix}camera_stand_link" link2="${prefix}xarm_vacuum_gripper_link" reason="Adjacent" />
+    <disable_collisions link1="${prefix}ft_sensor_link" link2="${prefix}xarm_vacuum_gripper_link" reason="RigidToolStack" />
+    <disable_collisions link1="${prefix}link6" link2="${prefix}ft_sensor_link" reason="RigidToolStack" />
+    <disable_collisions link1="${prefix}link6" link2="${prefix}camera_stand_link" reason="RigidToolStack" />
   </xacro:macro>
 </robot>
