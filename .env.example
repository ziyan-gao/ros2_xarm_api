# Local Docker Compose settings. Copy this file to .env before editing.
#
# Adds this amount to each item's virtual X/Y footprint. The physical item
# dimensions, published FLB loading corner, and Z dimension are unchanged.
RANDOM_LOADING_CLEARANCE_MM=10

# Fraction of vertically reachable stable candidates sampled before minimizing X+Y+Z.
RANDOM_LOADING_SAMPLE_FRACTION=0.30

# Central fraction of the real item X/Y footprint that must fit completely
# inside the support hull. Larger values require broader support.
RANDOM_LOADING_COM_BOUND_RATIO=0.20

# Maximum time for either downward place phase before releasing the item and
# returning through the transfer waypoint.
PLACE_DESCENT_TIMEOUT_SEC=20.0

# Separate bounded window for 3 mm direct steps after Servo singularity.
PLACE_SINGULARITY_RECOVERY_TIMEOUT_SEC=20.0

# After a place-only Servo singularity hard stop, finish the bounded descent
# through synchronous relative xArm service steps, checking force after each.
PLACE_SINGULARITY_STEP_M=0.003
PLACE_SINGULARITY_STEP_SPEED_MM_S=10.0
