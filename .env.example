# Local Docker Compose settings. Copy this file to .env before editing.
# Random loading geometry and motion coupling are configured in this YAML.
RANDOM_LOADING_CONFIG_PATH=/opt/neuromeka_bin_packing/configs/real_platform_random.yaml

# Maximum time for either downward place phase before releasing the item and
# returning through the transfer waypoint.
PLACE_DESCENT_TIMEOUT_SEC=20.0

# Separate bounded window for 3 mm direct steps after Servo singularity.
PLACE_SINGULARITY_RECOVERY_TIMEOUT_SEC=20.0

# After a place-only Servo singularity hard stop, finish the bounded descent
# through synchronous relative xArm service steps, checking force after each.
PLACE_SINGULARITY_STEP_M=0.003
PLACE_SINGULARITY_STEP_SPEED_MM_S=10.0

# Commissioned maximum for direct Cartesian lift/loading/retreat. The RViz
# non-servo slider scales these values; safe-servo descent is unaffected.
DIRECT_CARTESIAN_MAX_SPEED_MM_S=200.0
DIRECT_CARTESIAN_MAX_ACCEL_MM_S2=500.0

# Combined new-item PickAndPlace: one validated lift/transfer/pre-place path.
# Set false to retain the separate lift, joint transfer and loading phases.
CONTINUOUS_TRANSPORT_ENABLED=true
CONTINUOUS_RETURN_ENABLED=true
CONTINUOUS_TRANSPORT_BLEND_RADIUS_M=0.04
# Optional extra software jerk cap; off restores velocity/acceleration-only retiming.
CONTINUOUS_TRANSPORT_ENFORCE_JERK_LIMIT=false
# rad/s^3 at 100% speed, only enforced when enabled; not a manufacturer-rated limit.
CONTINUOUS_TRANSPORT_MAX_JOINT_JERK_RAD_S3=10.0

# Number of distinct timestamped depth-refined box estimates that must agree
# before Estimate Object Info moves toward the object.
OBJECT_INFO_STABLE_SAMPLES=20
